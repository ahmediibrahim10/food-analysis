{
  "name": "health-os",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "test:core": "node --experimental-strip-types --test tests/core.test.ts tests/provider.test.ts",
